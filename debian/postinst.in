#!/bin/sh
set -e

. /usr/share/debconf/confmodule

db_get msttcorefonts/accepted-mscorefonts-eula
if [ "$RET" != "true" ]; then
    echo "EULA not accepted, not installing fonts." >&2
    exit 0
fi

# Handle fontconfig symlink for emoji prioritization
if [ "$1" = "configure" ]; then
    mkdir -p /etc/fonts/conf.d
    ln -sf /etc/fonts/conf.avail/99-msttcorefonts-priority.conf /etc/fonts/conf.d/99-msttcorefonts-priority.conf
fi

# The logic from update-ms-fonts is concatenated below:
